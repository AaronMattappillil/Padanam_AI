# Application Settings
PROJECT_NAME="Padanam AI"
API_V1_STR="/api/v1"
SECRET_KEY="padanam-secret-key-super-secure-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database URL
# For local SQLite async fallback: sqlite+aiosqlite:///./padanam.db
# For PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/padanam_db
DATABASE_URL="sqlite+aiosqlite:///./padanam.db"

# Vector Database (Chroma)
CHROMA_PERSIST_DIR="./chroma_db"

# LLM Configuration
# Options: "local" (rule-based fallback), "openai", "gemini"
LLM_PROVIDER="local"
OPENAI_API_KEY="your-openai-api-key-here"
GEMINI_API_KEY="your-gemini-api-key-here"

# Environment
ENVIRONMENT="development"
LOG_LEVEL="INFO"
